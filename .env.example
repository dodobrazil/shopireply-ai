# ShopiReply AI Environment Variables

# ============================================================
# SUPABASE (REQUIRED)
# ============================================================
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# AI PROVIDER (REQUIRED)
# OpenAI-compatible endpoint - works with OpenAI, Together AI, Groq, Ollama etc.
# ============================================================
AI_API_KEY=sk-your-openai-or-compatible-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ============================================================
# STRIPE PAYMENTS (OPTIONAL - for international users)
# If absent, app shows "Contact for subscription" flow instead
# Get these from: https://dashboard.stripe.com/apikeys
# ============================================================
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs - create in Stripe dashboard
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_id
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id

# ============================================================
# MANUAL PAYMENT (Turkey / iyzico / PayTR)
# Used when Stripe is not configured or user selects Turkish payment
# ============================================================
MANUAL_PAYMENT_CONTACT_EMAIL=billing@yourdomain.com
MANUAL_PAYMENT_WHATSAPP=+90XXXXXXXXXX

# ============================================================
# EMAIL (OPTIONAL - for transactional emails)
# Resend: https://resend.com
# Or use SMTP credentials below
# ============================================================
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# SMTP fallback (if Resend not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_APP_URL=https://shopireply.com
NEXT_PUBLIC_APP_NAME=ShopiReply AI

# Admin access - comma-separated emails
ADMIN_EMAILS=admin@yourdomain.com

# ============================================================
# ANALYTICS (OPTIONAL)
# ============================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
